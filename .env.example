# Copy this file to .env and adjust as needed.
# When moving from your laptop to the office server, this is usually the
# only file you need to change.

# ============================================
# Server Configuration
# ============================================
PORT=8000
HOST=0.0.0.0

# ============================================
# Model Provider Selection
# ============================================
# Options: ollama (local), vllm (GPU deployment), openai (cloud)
MODEL_PROVIDER=ollama

# ============================================
# Ollama Configuration (Local Development)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# vLLM Configuration (GPU Deployment)
# ============================================
# Uncomment and configure for GPU deployment
# VLLM_BASE_URL=http://localhost:8000
# VLLM_API_KEY=your_api_key_here

# ============================================
# OpenAI Configuration (Optional)
# ============================================
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Model Configuration
# ============================================
# Small models for local laptop development
EMBEDDING_MODEL=bge-m3
LLM_MODEL=phi4-mini

# Larger models for GPU deployment (uncomment when using vLLM)
# EMBEDDING_MODEL=BAAI/bge-m3
# LLM_MODEL=meta-llama/Llama-3-8b

# ============================================
# GPU Optimization Settings
# ============================================
# Set to true when using GPU deployment
GPU_ENABLED=false

# Batch sizes for GPU operations (increase for better GPU utilization)
GPU_BATCH_SIZE_EMBEDDINGS=32
GPU_BATCH_SIZE_LLM=4

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=8

# Enable streaming responses (future feature)
ENABLE_STREAMING=false

# ============================================
# Chunking Configuration
# ============================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_CHUNKS=5

# ============================================
# Performance Tuning
# ============================================
EMBEDDING_TIMEOUT=120
LLM_TIMEOUT=300

# ============================================
# CORS Configuration
# ============================================
# Add your frontend URLs here
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================
# Storage Paths
# ============================================
# These are defaults, usually no need to change
# UPLOAD_DIR=./data/uploads
# CHROMA_PERSIST_DIR=./data/chroma_db
# CHROMA_COLLECTION_NAME=documents
